---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About us | IDDI NEWS" description="Learn about IDDI NEWS, a bilingual education and news platform from Nueva Granada in Barranquilla.">
  <section class="page-hero">
    <h1>About IDDI NEWS</h1>
    <p>A space for bilingual learning, useful information and the voices of our school community.</p>
  </section>
  <section class="section">
    <div class="split">
      <img src="/images/about.png" alt="Students sharing a learning experience" />
      <div class="section-copy">
        <p class="eyebrow">Our purpose</p>
        <h2>Learning and growing together</h2>
        <p><strong>IDDI NEWS</strong> is a digital platform of the English Department at Institución Educativa Distrital Bilingüe Nueva Granada in Barranquilla, Colombia.</p>
        <p>We share educational news and articles, primarily in English, to encourage bilingual learning and keep our school community informed. Our goal is to offer relevant, engaging content that supports students, families and educators.</p>
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <h2 class="section-heading">A bilingual community</h2>
    <p class="section-intro">We believe language opens doors to new ideas and connections. Through news, projects and school stories, we make space for our community to learn, participate and share its work.</p>
  </section>
</BaseLayout>

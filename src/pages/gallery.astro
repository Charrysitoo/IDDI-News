---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import { getGalleryPhotos } from "../data/gallery";

const photos = getGalleryPhotos();
---
<BaseLayout title="Photo gallery | IDDI NEWS" description="Photos from the activities and events of the Nueva Granada school community.">
  <section class="page-hero">
    <h1>Photo gallery</h1>
    <p>Take a closer look at the activities, events and people that make up our learning community.</p>
  </section>
  <section class="section">
    <p class="section-intro">Our gallery offers a glimpse into school life and the initiatives that help create a dynamic, enriching learning environment. Click any photo to see it up close.</p>
    <div class="gallery-grid" data-gallery>
      {photos.map((photo, index) => (
        <button
          type="button"
          class:list={["gallery-item", photo.height > photo.width && "ratio-portrait"]}
          data-photo-index={index}
          aria-label={`Open photo ${index + 1} in full-screen view`}
        >
          <Image
            src={photo.source}
            alt={photo.alt}
            width={Math.min(photo.width, 720)}
            sizes="(max-width: 480px) 92vw, (max-width: 820px) 45vw, 31vw"
            loading={index < 4 ? "eager" : "lazy"}
            decoding="async"
            class="gallery-img"
          />
          <span class="gallery-zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16" y2="16" />
              <line x1="11" y1="8" x2="11" y2="14" />
              <line x1="8" y1="11" x2="14" y2="11" />
            </svg>
          </span>
        </button>
      ))}
    </div>
  </section>

  <PhotoLightbox photos={photos} />
</BaseLayout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 150px;
    grid-auto-flow: dense;
    gap: 18px;
    max-width: 1240px;
    margin: 40px auto 0;
  }
  .gallery-item {
    position: relative;
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 16px;
    overflow: hidden;
    cursor: zoom-in;
    background: #e6f1fa;
    box-shadow: 0 10px 28px rgb(20 52 84 / 12%);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .gallery-item:hover,
  .gallery-item:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 18px 44px rgb(7 88 166 / 28%);
  }
  .gallery-item:focus-visible {
    outline: 3px solid var(--blue-bright);
    outline-offset: 3px;
  }
  .gallery-item.ratio-portrait {
    grid-row: span 2;
  }
  .gallery-item :global(.gallery-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), filter 0.35s ease;
  }
  .gallery-item:hover :global(.gallery-img) {
    transform: scale(1.05);
    filter: saturate(1.08);
  }
  .gallery-zoom {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(rgb(6 61 115 / 0%) 45%, rgb(6 61 115 / 55%));
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .gallery-zoom svg {
    background: rgb(7 88 166 / 78%);
    padding: 9px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transform: scale(0.7);
    transition: transform 0.3s ease;
  }
  .gallery-item:hover .gallery-zoom,
  .gallery-item:focus-visible .gallery-zoom {
    opacity: 1;
  }
  .gallery-item:hover .gallery-zoom svg,
  .gallery-item:focus-visible .gallery-zoom svg {
    transform: scale(1);
  }
  @media (max-width: 820px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr;

    }
  }
</style>

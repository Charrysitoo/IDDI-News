---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact | IDDI NEWS" description="Contact the English Department at Nueva Granada in Barranquilla, Colombia.">
  <section class="page-hero">
    <h1>Keep in touch</h1>
    <p>We would love to hear from our school community and share what is happening at Nueva Granada.</p>
  </section>
  <section class="section">
    <div class="contact-info">
      <p class="eyebrow">Get connected</p>
      <h2>English Department</h2>
      <p><strong>Institución Educativa Distrital Bilingüe Nueva Granada</strong><br />Barranquilla, Colombia</p>
      <p>For questions about IDDI NEWS, bilingual learning projects or school news, please contact the English Department through the school’s usual communication channels.</p>
      <a class="button" href="/">Return to home</a>
    </div>
  </section>
</BaseLayout>
